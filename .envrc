# direnv + devbox 統合
# 必要: direnv (https://direnv.net/), devbox (https://www.jetify.com/devbox)
# 1. direnv をインストール: `brew install direnv`
# 2. シェルにフック追加（[公式ドキュメント](https://direnv.net/docs/hook.html)参照）
# 3. devbox をインストール: `curl -fsSL https://get.jetify.com/devbox | bash`
# 4. `direnv allow` を実行

eval "$(devbox generate direnv --print-envrc)"

if [ -f package-lock.json ] && [ ! -d node_modules ]; then
  npm ci
fi
